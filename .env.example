# Copy to .env (never commit .env) and fill in.
# Generate the tool secret with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TOOL_BEARER_SECRET=
# Shown by ElevenLabs when you create the post-call webhook with HMAC auth.
ELEVENLABS_WEBHOOK_SECRET=
# Optional. Default 1800 (30 minutes), the same as ElevenLabs' SDK.
WEBHOOK_TOLERANCE_SECONDS=1800
# Optional. Default 2. How long the claim-status tool waits on its backend before it
# answers 200 with a fallback the agent can say. Keep it under the tool's
# response_timeout_secs in ElevenLabs (5 in the example config).
TOOL_BUDGET_SECONDS=2
# Optional. Default calls.sqlite3. One durable record per call, keyed on conversation_id.
CALL_STORE_PATH=calls.sqlite3
